# Адрес проекта Supabase и публичный ключ. Ключ anon не секрет: доступ к данным
# ограничивают политики RLS, а не он. Секретный ключ (service_role) в приложение не попадает.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<ключ-anon-из-supabase-status>

# Адрес API. По умолчанию — Edge Function `api` в том же проекте, менять нужно редко.
# VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api

# Пароль демо-аккаунта (demo@example.com). Данные в нём вымышленные,
# поэтому пароль не секрет — он нужен кнопке «Посмотреть демо».
VITE_DEMO_PASSWORD=demo-password-2026

# Только для скрипта наполнения демо-данными (npm run seed:demo). В браузер не попадает,
# в репозиторий не коммитится: хранить в .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 — идентификатор измерения (не секрет: он виден в коде страницы).
# Пусто — аналитика не загружается. Локально не нужен: в разработке тег не грузится.
VITE_GA_ID=
